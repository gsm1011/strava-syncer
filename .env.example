# Strava: create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8080/auth/strava/callback

# Facebook: create an app in Meta for Developers and enable Page permissions.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0
FACEBOOK_REDIRECT_URI=http://localhost:8080/auth/facebook/callback
# Optional when the account manages more than one Page.
FACEBOOK_PAGE_ID=

# Optional: mount a corporate/root CA bundle into the container and set this
# path if outbound HTTPS is intercepted by a local proxy.
# SSL_CERT_FILE=/run/certs/corporate-ca-bundle.pem
